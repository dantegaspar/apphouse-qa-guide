# Variables de entorno de AppHouse QA Guide.
# Copia este archivo a .env (Docker Compose) o a .env.local (desarrollo con npm run dev)
# y ajusta los valores. Nunca subas el archivo real a Git.

# Contraseña del panel /admin. OBLIGATORIA: sin ella el panel no permite entrar.
ADMIN_PASSWORD=cambia-esta-contraseña

# Contraseña del guía de la prueba. La escribe el guía en el celular del tester para desbloquear
# una actividad ("Ya se resolvió, continuar") o para terminar la prueba por un bloqueo.
# Usa una distinta de ADMIN_PASSWORD. Si la dejas vacía, se usa ADMIN_PASSWORD.
GUIDE_PASSWORD=

# Secreto para firmar la sesión del panel /admin. Opcional.
# Si lo dejas vacío, se deriva de ADMIN_PASSWORD. Si lo cambias, todas las sesiones activas se cierran.
# Genera uno con: openssl rand -hex 32
SESSION_SECRET=

# Llave de la API de Claude para «Dictaminar con Claude» en /admin/veredicto. Opcional.
# Sin ella, el botón aparece desactivado. A Claude no se le mandan nombres, correos ni teléfonos.
ANTHROPIC_API_KEY=

# Tamaño máximo de cada archivo subido (captura o video), en MB. Por defecto: 15.
MAX_UPLOAD_MB=15

# Carpeta de la base de datos SQLite (qa.sqlite). Por defecto: ./data
# Con Docker Compose no hace falta cambiarla: el contenedor usa /app/data (carpeta qa-data/data del servidor).
# DATA_DIR=./data

# Carpeta donde se guardan las capturas y videos subidos. Por defecto: ./uploads
# Con Docker Compose no hace falta cambiarla: el contenedor usa /app/uploads (carpeta qa-data/uploads del servidor).
# UPLOAD_DIR=./uploads

# Solo Docker Compose: carpeta del servidor donde viven TODOS los datos (base, subidas y
# respaldos). Ningún comando de Docker la borra. Por defecto: ./qa-data
# QA_DATA_PATH=/srv/apphouse-qa

# Respaldos automáticos de la base: cada cuántos minutos (0 = apagado) y cuántos guardar.
# BACKUP_EVERY_MIN=10
# BACKUP_KEEP=144

# Puerto HTTP de la app. Por defecto: 3000.
# En Docker Compose es el puerto que se publica en tu computadora o servidor.
PORT=3000

# Solo desarrollo: dominios extra que pueden abrir el servidor de dev (ej. un túnel), separados por comas
# DEV_ORIGINS=
